{
  "name": "surakshit-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Surakshit Vault - Zero-Knowledge Personal Password Vault built on React, TypeScript, Cloudflare Pages, Workers, and D1",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.worker.json --noEmit",
    "pages:dev": "npm run build && wrangler pages dev dist --d1 DB=surakshit-vault-db",
    "pages:deploy": "npm run build && wrangler pages deploy dist --project-name=surakshit-vault",
    "db:migrate:local": "wrangler d1 execute surakshit-vault-db --local --file=./migrations/0001_initial_schema.sql",
    "db:migrate:remote": "wrangler d1 execute surakshit-vault-db --remote --file=./migrations/0001_initial_schema.sql"
  },
  "dependencies": {
    "@noble/hashes": "^1.7.1",
    "clsx": "^2.1.1",
    "hash-wasm": "^4.12.0",
    "hono": "^4.7.2",
    "lucide-react": "^0.475.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tailwind-merge": "^3.0.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250214.0 || ^5.0.0",
    "@types/node": "^22.13.4",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.2",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "vite": "^6.1.0",
    "vitest": "^3.0.5",
    "wrangler": "^4.0.0"
  }
}
